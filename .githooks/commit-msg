#!/bin/sh
# Every commit in this repo is authored by Shashwat Goyal alone.
# Refuse messages that credit an AI assistant as a contributor.
if grep -Eiq '^co-authored-by:.*(claude|anthropic)|generated with \[?claude' "$1"; then
  echo "commit-msg: remove the AI attribution line; this repo has one author." >&2
  exit 1
fi
