#!/bin/sh
# Refuse commits that would publish secrets. .gitignore already keeps .env
# and .pem files out; this catches a forced add or a key pasted into code.

staged=$(git diff --cached --name-only --diff-filter=ACM)

for file in $staged; do
  case "$file" in
    .env.example) ;;
    .env|.env.*|*/.env|*/.env.*|*.pem|*.key|*.p12)
      echo "pre-commit: $file looks like a secrets file; it must not be committed." >&2
      exit 1
      ;;
  esac
done

# Real key shapes only: Anthropic, OpenAI, Google, GitHub, and private keys.
if git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -Eq \
  'sk-ant-[A-Za-z0-9_-]{20,}|sk-(proj-)?[A-Za-z0-9_-]{32,}|AIza[0-9A-Za-z_-]{35}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|BEGIN [A-Z ]*PRIVATE KEY'; then
  echo "pre-commit: the staged changes contain what looks like an API key or private key." >&2
  echo "Remove it, or keep it in a git-ignored .env file instead." >&2
  exit 1
fi
