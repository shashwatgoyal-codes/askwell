{
  "name": "@askwell/preflight",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Checks your AI prompt before you send it.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm notices && wxt build",
    "build:firefox": "pnpm notices && wxt build -b firefox --mv3",
    "build:edge": "pnpm notices && wxt build -b edge",
    "build:safari": "pnpm notices && wxt build -b safari",
    "zip": "pnpm notices && wxt zip && wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:e2e": "wxt build && playwright test",
    "test": "vitest run",
    "notices": "node ../../scripts/notices.mjs"
  },
  "dependencies": {
    "@askwell/rules": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@askwell/improve": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
