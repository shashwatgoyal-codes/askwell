# Copy to .env.local for local development. Never commit real values.

# Neon connection string. Leave unset to run on an in-memory database.
DATABASE_URL=

# Sign-in for /login: your email, and the hash of a long password (a password manager's 20+ characters).
ADMIN_EMAIL=
# Not the password itself: run `pnpm --filter @askwell/portal hash-password` and paste what it prints.
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie: 32+ random characters (openssl rand -base64 48).
SESSION_SECRET=

# The owner's Anthropic key that admin tokens spend.
ANTHROPIC_API_KEY=

# Optional: model for token holders' rewrites, and a cap on all tokens together per day.
PORTAL_MODEL=claude-opus-5-5
GLOBAL_DAILY_LIMIT=200
