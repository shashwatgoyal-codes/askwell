{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "!dist/*.zip"]
    },
    "zip": {
      "dependsOn": ["^build"],
      "outputs": ["dist/*.zip"]
    },
    "test": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
